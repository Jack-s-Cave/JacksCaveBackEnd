# Get all users
GET http://localhost:1337/api/author-profiles?populate[foto][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get one user
GET http://localhost:1337/api/author-profiles?filters[id][$eq]=2&populate[foto][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all series
GET http://localhost:1337/api/series
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get one series
GET http://localhost:1337/api/series?filter[id][$eq]=1
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all articles
GET http://localhost:1337/api/articles?populate[media][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get the most recent articles (6)
GET http://localhost:1337/api/articles
  ?sort[0]=createdAt:desc
  &pagination[page]=1
  &pagination[pageSize]=6
  &populate[media][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all articles of one user
GET http://localhost:1337/api/articles?filters[author_profile][id][$eq]=2&populate[media][fields][0]=url&populate[author_profile][fields][0]=nombre&populate[author_profile][fields][1]=bio
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get one articles
GET http://localhost:1337/api/articles?filters[id][$eq]=6
  &populate[media][fields][0]=url
  &populate[author_profile][fields][0]=nombre
  &populate[author_profile][fields][1]=bio
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all articles by filters
GET http://localhost:1337/api/articles
  ?filters[title][$eq]=Focas%20embarazadas
  &populate[media][fields][0]=url
  &populate[author_profile][fields][0]=nombre
  &populate[author_profile][fields][1]=bio
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all articles of a serie
GET http://localhost:1337/api/articles
  ?filters[serie][name][$eq]=focas
  &populate[media][fields][0]=url
  &populate[author_profile][fields][0]=nombre
  &populate[author_profile][fields][1]=bio
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all articles of the "focas" series
GET http://localhost:1337/api/articles?filters[serie][slug][$eq]=focas&populate[media][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all Podcast
GET http://localhost:1337/api/podcasts?populate[image][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get one Podcast
GET http://localhost:1337/api/podcasts?filters[id][$eq]=1&populate[image][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get the most recent podcasts (6)
GET http://localhost:1337/api/podcasts
  ?sort[0]=date_publication:desc
  &pagination[page]=1
  &pagination[pageSize]=6
  &populate[image][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get podcast crew
GET http://localhost:1337/api/podcast-crew?populate[photos][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all asociaciones (básico - sin components)
GET http://localhost:1337/api/asociaciones
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get all asociaciones CON miembros y fotos
GET http://localhost:1337/api/asociaciones?populate[Miembro][populate][foto][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get asociación por año específico CON miembros y fotos
GET http://localhost:1337/api/asociaciones?filters[year][$eq]=2024&populate[Miembro][populate][foto][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# Get asociaciones ordenadas por año descendente
GET http://localhost:1337/api/asociaciones?sort[0]=year:desc&populate[Miembro][populate][foto][fields][0]=url
Authorization: Bearer {{$dotenv STRAPI_TOKEN}}

# ===== ARTICLE MD ENDPOINTS =====
# Get all Article_MD (completo - todo de todo)
GET http://localhost:1337/api/article-mds?populate=*

# Get los 6 artículos más recientes (para landing page)
GET http://localhost:1337/api/article-mds?sort[0]=fecha_de_publicacion:desc&pagination[page]=1&pagination[pageSize]=6&populate=*

# ===== BÚSQUEDA DE ARTÍCULOS =====

# Búsqueda por texto (título o autor)
GET http://localhost:1337/api/article-mds?filters[$or][0][Titulo][$containsi]={{TERMINO_BUSQUEDA}}&filters[$or][1][author_profile][nombre][$containsi]={{TERMINO_BUSQUEDA}}&populate=*

# ===== FILTROS POR TAGS =====

# Filtrar por UN tag específico
GET http://localhost:1337/api/article-mds?filters[tags][$eq]=Linux&populate=*

# Filtrar por MÚLTIPLES tags (OR - cualquiera de estos)
GET http://localhost:1337/api/article-mds?filters[$or][0][tags][$eq]=Linux&filters[$or][1][tags][$eq]=Windows&filters[$or][2][tags][$eq]=MacOS&populate=*

# ===== FILTROS POR FECHA =====

# Filtrar por fecha DESDE (mayor o igual que)
GET http://localhost:1337/api/article-mds?filters[fecha_de_publicacion][$gte]=2025-01-01&populate=*

# Filtrar por fecha HASTA (menor o igual que)
GET http://localhost:1337/api/article-mds?filters[fecha_de_publicacion][$lte]=2025-12-31&populate=*

# Filtrar por RANGO de fechas (desde - hasta)
GET http://localhost:1337/api/article-mds?filters[fecha_de_publicacion][$gte]=2025-01-01&filters[fecha_de_publicacion][$lte]=2025-12-31&populate=*

# ===== COMBINACIÓN DE FILTROS =====

# Tags + Fechas (sin búsqueda de texto)
GET http://localhost:1337/api/article-mds?filters[$and][0][$or][0][tags][$eq]=Linux&filters[$and][0][$or][1][tags][$eq]=Ciberseguridad&filters[$and][1][fecha_de_publicacion][$gte]=2025-01-01&filters[$and][1][fecha_de_publicacion][$lte]=2025-12-31&populate=*

# ===== ORDENAMIENTO =====

# Ordenar por fecha descendente (más recientes primero)
GET http://localhost:1337/api/article-mds?sort[0]=fecha_de_publicacion:desc&populate=*

# Ordenar por fecha ascendente (más antiguos primero)
GET http://localhost:1337/api/article-mds?sort[0]=fecha_de_publicacion:asc&populate=*

# Ordenar por título alfabético
GET http://localhost:1337/api/article-mds?sort[0]=Titulo:asc&populate=*

# ===== PAGINACIÓN =====

# Primera página (6 artículos)
GET http://localhost:1337/api/article-mds?pagination[page]=1&pagination[pageSize]=6&populate=*

# Segunda página
GET http://localhost:1337/api/article-mds?pagination[page]=2&pagination[pageSize]=6&populate=*

# ===== FILTROS POR AUTOR =====

# Artículos de un autor específico (por nombre)
GET http://localhost:1337/api/article-mds?filters[author_profile][nombre][$eq]=Pedro Rodrigues&populate=*

